# ISSH Server Docker Deployment Config
ISSH_PORT=8080

# 非常重要：32位以上随机强密钥，用于 AES-256-GCM 加密用户云端配置。
# 灾备恢复 .zip 备份包时，必须保持与原服务器一致的 ISSH_MASTER_KEY！
ISSH_MASTER_KEY=replace-with-your-own-32-byte-random-secret

# 首次启动自动创建的管理员账号（仅数据库无管理员时生效）
ISSH_ADMIN_EMAIL=admin@issh.local
ISSH_ADMIN_PASSWORD=admin123456

# CORS 允许来源（默认 *，生产可限制为你的域名）
ISSH_CORS_ORIGIN=*
