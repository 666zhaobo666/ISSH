{
  "name": "issh",
  "version": "0.1.18",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=@issh/desktop",
    "dev:admin": "npm run dev --workspace=@issh/admin",
    "build:core": "npm run build --workspace=@issh/core",
    "build:desktop": "npm run build --workspace=@issh/desktop",
    "build:admin": "npm run build --workspace=@issh/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version:sync": "node scripts/sync-version.mjs"
  }
}
